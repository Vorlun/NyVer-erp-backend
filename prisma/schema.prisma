generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum Role {
  SUPERADMIN
  ADMIN
  TEACHER
  STUDENT
  ASSISTANT
}

enum Status {
  ACTIVE
  INACTIVE
  FROZEN
  ARCHIVED
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum GroupStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum HomeworkSubmissionStatus {
  PENDING // Topshirildi, tekshirilishi kutilmoqda
  ACCEPTED // Qabul qilindi
  CHECKED // Tekshirildi va baholandi
  REJECTED // Qaytarildi (qayta ishlashga)
  NOT_SUBMITTED // Bajarilmadi
}

enum PaymentType {
  CASH
  CARD
  BANK_TRANSFER
  PAYME
  CLICK
  UZUM
}

enum PaymentStatus {
  PAID
  PENDING
  REFUNDED
}

enum CoinReason {
  ATTENDANCE
  HOMEWORK_EXCELLENT
  EXAM_TOP
  PRIZE_PURCHASE
  MANUAL_ADJUSTMENT
}

// ------------------------------------------------------
// USER & AUTHENTICATION
// ------------------------------------------------------

model User {
  id        Int       @id @default(autoincrement())
  firstName String
  lastName  String
  role      Role      @default(STUDENT)
  email     String?   @unique
  phone     String    @unique
  birthDate DateTime?
  password     String
  tempPassword String?
  photo        String?
  coins        Int       @default(0)
  balance      Decimal   @default(0) @db.Decimal(14, 2)
  address      String?
  status       Status    @default(ACTIVE)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relatsiyalar
  studentEnrollments  GroupStudent[]
  teachingGroups      GroupTeacher[]
  createdLessons      Lesson[]             @relation("TeacherLessons")
  markedAttendances   Attendance[]         @relation("MarkedByTeacher")
  studentAttendances  Attendance[]         @relation("StudentAttendances")
  homeworkSubmissions HomeworkSubmission[] @relation("StudentSubmissions")
  checkedSubmissions  HomeworkSubmission[] @relation("TeacherCheckedSubmissions")
  coinTransactions    CoinTransaction[]
  payments            Payment[]
  examResults         ExamResult[]
  prizeOrders         PrizeOrder[]

  @@index([role, status])
}

// ------------------------------------------------------
// COURSES & INFRASTRUCTURE
// ------------------------------------------------------

model Course {
  id              Int     @id @default(autoincrement())
  name            String  @unique
  description     String?
  price           Decimal @db.Decimal(12, 2)
  durationMonths  Int     @default(1)
  lessonsPerMonth Int     @default(12)
  totalLessons    Int     @default(12)
  status          Status  @default(ACTIVE)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  groups   Group[]
  syllabus CourseSyllabus[]
  payments Payment[]
}

// Standart dars rejasi shabloni (o'qituvchiga avtomatik to'ldirish uchun)
model CourseSyllabus {
  id          Int     @id @default(autoincrement())
  lessonOrder Int
  topic       String
  description String?
  courseId    Int

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, lessonOrder])
}

model Room {
  id       Int    @id @default(autoincrement())
  name     String @unique
  capacity Int
  status   Status @default(ACTIVE)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  groups  Group[]
  lessons Lesson[]
}

// ------------------------------------------------------
// GROUPS & SCHEDULE
// ------------------------------------------------------

model Group {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  startDate   DateTime
  endDate     DateTime?
  startTime   String // "14:00"
  endTime     String // "16:00"
  maxStudents Int         @default(15)
  weekDays    WeekDay[]
  status      GroupStatus @default(PLANNED)

  courseId Int
  roomId   Int

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  course   Course         @relation(fields: [courseId], references: [id])
  room     Room           @relation(fields: [roomId], references: [id])
  students GroupStudent[]
  teachers GroupTeacher[]
  lessons  Lesson[]
  exams    Exam[]

  @@index([courseId, roomId, status])
}

model GroupStudent {
  id        Int      @id @default(autoincrement())
  studentId Int
  groupId   Int
  joinedAt  DateTime @default(now())
  status    Status   @default(ACTIVE)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([studentId, groupId])
}

model GroupTeacher {
  id        Int     @id @default(autoincrement())
  teacherId Int
  groupId   Int
  isMain    Boolean @default(true) // Asosiy ustoz yoki Assistent
  status    Status  @default(ACTIVE)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  teacher User  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([teacherId, groupId])
}

// ------------------------------------------------------
// LESSONS, ATTENDANCE & HOMEWORK
// ------------------------------------------------------

model Lesson {
  id          Int      @id @default(autoincrement())
  lessonOrder Int // Guruh bo'yicha nechanchi darsligi (1, 2, 3...)
  topic       String // Standart rejadan keladi yoki o'qituvchi o'zgartiradi
  description String?
  videoUrl    String?
  content     String?  @db.Text
  attachedFiles String[] @default([])
  lessonDate  DateTime @db.Date
  startTime   String?
  endTime     String?

  groupId   Int
  teacherId Int?
  roomId    Int?
  status    Status @default(ACTIVE)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher User? @relation("TeacherLessons", fields: [teacherId], references: [id], onDelete: SetNull)
  room    Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  attendances Attendance[]
  homework    Homework?
  submissions HomeworkSubmission[] @relation("LessonSubmissions")
  materials   LessonMaterial[]

  @@unique([groupId, lessonOrder])
  @@index([groupId, lessonDate])
}

model LessonMaterial {
  id       Int     @id @default(autoincrement())
  title    String
  fileUrl  String
  fileType String?
  sizeMb   Float?
  lessonId Int

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Attendance {
  id          Int              @id @default(autoincrement())
  status      AttendanceStatus @default(PRESENT)
  coinsEarned Int              @default(0)
  note        String?

  studentId  Int
  lessonId   Int
  markedById Int

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  student  User   @relation("StudentAttendances", fields: [studentId], references: [id], onDelete: Cascade)
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  markedBy User   @relation("MarkedByTeacher", fields: [markedById], references: [id])

  @@unique([studentId, lessonId])
}

model Homework {
  id       Int       @id @default(autoincrement())
  title    String
  task     String    @db.Text
  fileUrls String[]  @default([])
  maxScore Int       @default(100)
  maxCoins Int       @default(10)
  deadline DateTime?

  lessonId Int @unique

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  lesson      Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions HomeworkSubmission[]
}

model HomeworkSubmission {
  id          Int                      @id @default(autoincrement())
  textAnswer  String?                  @db.Text
  fileUrls    String[]                 @default([])
  fileUrl     String?
  status      HomeworkSubmissionStatus @default(PENDING)
  score       Int? // 0 dan maxScore gacha
  coinsEarned Int                      @default(0)
  feedback    String?                  @db.Text

  homeworkId  Int
  lessonId    Int?
  studentId   Int
  checkedById Int?

  submittedAt DateTime  @default(now())
  checkedAt   DateTime?
  updated_at  DateTime  @updatedAt

  homework  Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  lesson    Lesson?  @relation("LessonSubmissions", fields: [lessonId], references: [id], onDelete: Cascade)
  student   User     @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  checkedBy User?    @relation("TeacherCheckedSubmissions", fields: [checkedById], references: [id], onDelete: SetNull)

  @@unique([homeworkId, studentId])
  @@index([homeworkId, status])
  @@index([lessonId, status])
}

// ------------------------------------------------------
// EXAMS & GAMIFICATION (COINS / PRIZES)
// ------------------------------------------------------

model Exam {
  id       Int      @id @default(autoincrement())
  title    String
  examDate DateTime
  maxScore Int      @default(100)
  groupId  Int

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  group   Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  results ExamResult[]
}

model ExamResult {
  id        Int     @id @default(autoincrement())
  score     Decimal @db.Decimal(5, 2)
  examId    Int
  studentId Int

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  exam    Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
}

model CoinTransaction {
  id          Int        @id @default(autoincrement())
  amount      Int // +10 (mukofot) yoki -50 (sovrin sotib olish)
  reason      CoinReason
  description String?
  userId      Int

  created_at DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Prize {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  imageUrl    String?
  priceCoins  Int
  stockCount  Int     @default(0)
  status      Status  @default(ACTIVE)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  orders PrizeOrder[]
}

model PrizeOrder {
  id         Int     @id @default(autoincrement())
  studentId  Int
  prizeId    Int
  coinsSpent Int
  isGiven    Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  prize   Prize @relation(fields: [prizeId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// PAYMENTS & BILLING
// ------------------------------------------------------

model Payment {
  id          Int           @id @default(autoincrement())
  amount      Decimal       @db.Decimal(12, 2)
  type        PaymentType   @default(CASH)
  status      PaymentStatus @default(PAID)
  paidForDate DateTime // Qaysi oy uchun to'lov ekanligi
  comment     String?
  receiptUrl  String?

  studentId Int
  courseId  Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([studentId, paidForDate])
  @@index([courseId])
}

// ------------------------------------------------------
// CONTACTS / LEADS
// ------------------------------------------------------

enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  REJECTED
}

model ContactRequest {
  id      Int           @id @default(autoincrement())
  name    String
  phone   String
  email   String?
  message String?       @db.Text
  status  ContactStatus @default(NEW)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([status, created_at])
}

